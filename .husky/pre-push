#!/usr/bin/env sh
# push 전 무거운 게이트를 조기 차단 (CI 와 중복이나 왕복 절약).
# 우회가 필요하면: git push --no-verify
#
# git 이 훅에 넘긴 레포 지정 변수를 지운다 — 링크된 워크트리에서 푸시하면 GIT_DIR 이 절대경로라, 아래 테스트가
# 임시 폴더에서 부르는 git(init·commit·worktree add)이 실제 레포에 적용된다(2026-10-01 core.bare=true 사고).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX
bun run typecheck && bun run test && cargo fmt --all --check && cargo test --workspace
