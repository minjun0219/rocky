#!/bin/sh
# rocky 부트스트랩 — 플러그인 버전에 맞는 네이티브 바이너리를 확보해 실행한다.
#
# 플러그인 설치본에는 소스만 있고 바이너리가 없다. 이 스크립트가 `.claude-plugin/plugin.json`
# 의 버전을 읽어 GitHub Release 의 tarball(rocky + rockyd)을
# `$XDG_DATA_HOME/rocky/v<version>/` 에 한 번 풀어 두고, 이후로는 그대로 exec 한다.
# 훅(hooks.json)과 CLI 가 같은 입구를 쓴다.
#
#   ROCKY_BIN           설정되면 다운로드 없이 그 바이너리를 실행한다 (레포에서 개발할 때
#                            `target/debug/rocky` 를 가리키는 용도).
#   ROCKY_RELEASE_BASE  tarball 을 받을 기준 URL (기본 GitHub Release 의
#                            `.../releases/download`). 미러·테스트용.
#
# 훅은 fail-open 이다 — 다운로드 실패·미지원 플랫폼이면 stderr 에 한 줄 남기고 0 으로
# 끝난다. 바이너리가 없는 상태에서 SessionStart 가 아닌 훅(UserPromptSubmit/Stop)은
# 자기 자리에서 받지 않는다 — 그쪽은 timeout 이 몇 초라 받다가 죽는다. 대신 SessionStart
# 경로(`hook ensure-daemon`)를 백그라운드로 한 번 띄워 받게 하고 0 으로 끝난다: 그 상황은
# `/reload-plugins` 로 플러그인만 새 버전이 된 세션이고, 그 끝에서 ensure-daemon 이 데몬도
# 새 버전으로 올린다. 다음 프롬프트부터는 새 바이너리가 직접 돈다.
set -eu

REPO="minjun0219/rocky"

if [ -n "${ROCKY_BIN:-}" ]; then
  exec "$ROCKY_BIN" "$@"
fi

# 플러그인 루트 — 훅은 CLAUDE_PLUGIN_ROOT 를 받고, 직접 실행은 자기 위치에서 거슬러 간다.
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  root="$CLAUDE_PLUGIN_ROOT"
else
  self="$0"
  # 슬래시 없는 이름(PATH 로 찾은 경우의 일부 셸)은 실제 경로로 바꾼다
  case "$self" in
    */*) ;;
    *) self="$(command -v "$self" 2>/dev/null || echo "$self")" ;;
  esac
  while [ -L "$self" ]; do
    target="$(readlink "$self")"
    case "$target" in
      /*) self="$target" ;;
      *) self="$(dirname "$self")/$target" ;;
    esac
  done
  root="$(cd "$(dirname "$self")/.." && pwd)"
fi

# jq 없이 읽는다 — 한 줄 JSON 도 잡히게 쉼표로 쪼갠 뒤 첫 "version" 을 취한다
if [ ! -f "$root/.claude-plugin/plugin.json" ]; then
  echo "rocky: $root 는 플러그인 디렉터리가 아니다 — 이 스크립트는 복사하지 말고 심볼릭 링크로 PATH 에 둔다" >&2
  exit 1
fi
version="$(tr ',' '\n' < "$root/.claude-plugin/plugin.json" | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
if [ -z "$version" ]; then
  echo "rocky: $root/.claude-plugin/plugin.json 에서 version 을 못 읽었다" >&2
  exit 1
fi

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
install_dir="$data_home/rocky/v$version"
bin="$install_dir/rocky"

is_hook=0
case "${1:-}" in hook) is_hook=1 ;; esac
is_session_start=0
if [ "$is_hook" = 1 ] && [ "${2:-}" = "ensure-daemon" ]; then is_session_start=1; fi

# `$data_home/rocky/current` → `v<version>` — 버전 없는 고정 진입점. 플러그인 밖에서 붙는
# 쪽(`claude -p --strict-mcp-config` 배치 잡, Codex·opencode 설정)이 릴리스마다 경로를
# 고치지 않게 `current/rocky mcp worklog` 를 가리키면 된다. 두 시점에 갱신한다 — 세션마다
# 한 번(SessionStart, 마지막으로 세션을 연 설치본의 버전을 따른다)과 **새 버전을 방금 받았을
# 때**(입구가 무엇이든). 후자가 없으면 `/reload-plugins` 뒤 worklog MCP 서버 기동이 새 버전을
# 받아 놓고도 링크는 옛 버전에 남아, `~/.local/bin/rocky` 와 `config show` 가 구버전을 본다
# (0.27→0.28 에서 실제로 그랬다). 임시 링크를 만든 뒤 `mv -h` 로 바꿔 끼워(rename) 읽는 쪽이
# 링크가 없는 순간을 보지 않게 한다. 실패해도 훅을 막지 않는다.
link_current() {
  link="$data_home/rocky/current"
  if [ "$(readlink "$link" 2>/dev/null || true)" != "v$version" ]; then
    ln -s "v$version" "$link.$$" 2>/dev/null || return 0
    # `-h`(BSD/macOS) · `-T`(GNU) — 둘 다 "링크가 가리키는 디렉터리 안으로 옮기지 말라"
    mv -fh "$link.$$" "$link" 2>/dev/null || mv -fT "$link.$$" "$link" 2>/dev/null || rm -f "$link.$$"
  fi
  link_cli
}

# `~/.local/bin/rocky` → `current/rocky` — 터미널에서 `rocky` 가 바로 불리게. 버전 링크를 거치므로
# 한 번 걸면 릴리스마다 따라온다. 이미 우리 링크면 그대로, 남의 파일(링크 아님)이면 건드리지 않는다.
# `~/.local/bin` 이 PATH 에 있는지는 셸 몫이다 — `rocky config show` 가 알려 준다.
link_cli() {
  target="$data_home/rocky/current/rocky"
  cli_dir="$HOME/.local/bin"
  cli="$cli_dir/rocky"
  [ "$(readlink "$cli" 2>/dev/null || true)" = "$target" ] && return 0
  [ -e "$cli" ] && [ ! -L "$cli" ] && return 0
  mkdir -p "$cli_dir" 2>/dev/null || return 0
  ln -s "$target" "$cli.$$" 2>/dev/null || return 0
  mv -fh "$cli.$$" "$cli" 2>/dev/null || mv -fT "$cli.$$" "$cli" 2>/dev/null || rm -f "$cli.$$"
}

if [ -x "$bin" ]; then
  if [ "$is_session_start" = 1 ]; then link_current; fi
  exec "$bin" "$@"
fi

if [ "$is_hook" = 1 ] && [ "$is_session_start" = 0 ]; then
  # 마커 디렉터리(mkdir 는 원자적)로 프롬프트마다 겹쳐 띄우지 않는다. 10분 넘은 마커는
  # 죽은 다운로드가 남긴 것이라 치우고 다시 띄운다. 자식의 stdio 는 전부 끊는다 — 훅의
  # stdout 파이프를 물고 있으면 Claude Code 가 이 훅이 끝난 줄을 모른다.
  marker="$install_dir.downloading"
  mkdir -p "$data_home/rocky" 2>/dev/null || exit 0
  if [ -d "$marker" ] && [ -n "$(find "$marker" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then
    rmdir "$marker" 2>/dev/null || true
  fi
  if mkdir "$marker" 2>/dev/null; then
    # 리다이렉션은 서브셸 전체에 — 안쪽 명령에만 걸면 서브셸이 훅의 파이프를 물고 있어
    # Claude Code(와 spawnSync 테스트)가 다운로드가 끝날 때까지 이 훅을 기다린다.
    ( "$root/bin/rocky" hook ensure-daemon; rmdir "$marker" 2>/dev/null ) </dev/null >/dev/null 2>&1 &
  fi
  exit 0
fi

fail() {
  echo "rocky: $1" >&2
  if [ "$is_hook" = 1 ]; then exit 0; fi
  exit 1
}

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) target="aarch64-apple-darwin" ;;
  *) fail "미지원 플랫폼 $(uname -s)/$(uname -m) — 릴리스는 Apple Silicon macOS 만 있다" ;;
esac

command -v curl >/dev/null 2>&1 || fail "curl 이 없다"
command -v shasum >/dev/null 2>&1 || fail "shasum 이 없다 (체크섬 검증에 필요)"

asset="rocky-v$version-$target.tar.gz"
base="${ROCKY_RELEASE_BASE:-https://github.com/$REPO/releases/download}/v$version"

tmp="$(mktemp -d "${TMPDIR:-/tmp}/rocky.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT

echo "rocky: v$version 바이너리를 내려받는다 ($asset)" >&2
# 시간 상한을 둔다 — 블랙홀 네트워크에서 훅이 세션 시작을 붙들면 안 된다. SessionStart 훅의
# 기본 timeout(60s) 안에서 끝나도록 tarball 45s / 체크섬 15s (연결 5s, 재시도 1회 포함).
curl -fsSL --connect-timeout 5 --max-time 45 --retry 1 --retry-max-time 45 \
  -o "$tmp/$asset" "$base/$asset" || fail "다운로드 실패: $base/$asset"
curl -fsSL --connect-timeout 5 --max-time 15 --retry 1 --retry-max-time 15 \
  -o "$tmp/SHA256SUMS" "$base/SHA256SUMS" || fail "다운로드 실패: $base/SHA256SUMS"
# 체크섬 파일에서 이 tarball 줄만 골라 검증한다
grep -- " $asset\$" "$tmp/SHA256SUMS" > "$tmp/SHA256SUMS.one" || fail "SHA256SUMS 에 $asset 이 없다"
(cd "$tmp" && shasum -a 256 -c --status SHA256SUMS.one) || fail "체크섬 불일치: $asset"

mkdir -p "$tmp/unpack"
tar -xzf "$tmp/$asset" -C "$tmp/unpack" || fail "압축 해제 실패: $asset"
[ -x "$tmp/unpack/rocky" ] && [ -x "$tmp/unpack/rockyd" ] || fail "tarball 에 바이너리가 없다"

mkdir -p "$data_home/rocky"
# 동시에 뜬 세션들이 같은 버전을 받아도 디렉터리 rename 은 원자적이다 —
# 먼저 온 쪽이 이기고 나머지는 자기 것을 버린다.
if ! mv "$tmp/unpack" "$install_dir" 2>/dev/null; then
  [ -x "$bin" ] || fail "설치 실패: $install_dir"
fi

# 지난 버전 디렉터리는 지우지 않는다 — 설치본 둘(마켓 + 로컬 레포)이 번갈아 뜨는 경우
# 버전마다 한 번만 받고 끝나게. 정리는 `rm -rf ~/.local/share/rocky` 로 사용자가 한다.
# 방금 받은 버전은 입구와 무관하게 `current` 로 삼는다 — 새 버전을 받는 순간이 곧 업그레이드다.
link_current
exec "$bin" "$@"
