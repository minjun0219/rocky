{
  "name": "@minjun0219/rocky",
  "version": "0.24.0",
  "description": "rocky (named after Project Hail Mary) — the owner's personal agent tool. A Rust daemon (shared todo board + MCP) and CLI under crates/, a thin Claude Code plugin under plugin/. This package only holds the Bun dev tooling (biome, changesets, release scripts) — there is no TypeScript runtime code left.",
  "license": "MIT",
  "author": "Minjun Kim",
  "homepage": "https://github.com/minjun0219/rocky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minjun0219/rocky.git"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "claude-code",
    "mcp",
    "todo",
    "board",
    "daemon",
    "worklog",
    "rocky",
    "rust",
    "bun"
  ],
  "scripts": {
    "check": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "bun test ./scripts ./plugin/scripts",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "changeset": "bunx changeset",
    "changeset:version": "bunx changeset version && bun scripts/sync-plugin-version.ts",
    "prepare": "husky",
    "check:changesets": "bun scripts/check-changesets.ts"
  },
  "lint-staged": {
    "*.{ts,json,jsonc,md}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@minjun0219/biome-config": "2.1.0",
    "@types/bun": "^1.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "typescript": "^5.4.5"
  }
}
