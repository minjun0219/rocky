{
  "name": "@minjun0219/rocky",
  "version": "0.46.0",
  "author": "Minjun Kim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minjun0219/rocky.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@happy-dom/global-registrator": "^20.11.1",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "@minjun0219/biome-config": "2.1.0",
    "@minjun0219/mdwire": "^0.1.7",
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "lucide-react": "^1.31.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.5",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zustand": "^5.0.14"
  },
  "description": "rocky (named after Project Hail Mary) — the owner's personal agent tool. A Rust daemon (shared todo board + MCP) and CLI under crates/, a thin Claude Code plugin under plugin/, and the board web UI under web/ (built to dist/ at release, served by the daemon). This package holds the Bun dev tooling and the UI build — there is no TypeScript server code.",
  "engines": {
    "bun": ">=1.0.0"
  },
  "homepage": "https://github.com/minjun0219/rocky",
  "keywords": [
    "claude-code",
    "mcp",
    "todo",
    "board",
    "daemon",
    "worklog",
    "rocky",
    "rust",
    "bun"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,json,jsonc,md}": "biome check --write --no-errors-on-unmatched"
  },
  "scripts": {
    "check": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "bun run test:unit && bun run test:dom",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "changeset": "bunx changeset",
    "changeset:version": "bunx changeset version && bun scripts/sync-plugin-version.ts",
    "prepare": "husky",
    "check:changesets": "bun scripts/check-changesets.ts",
    "build:ui": "bun scripts/build-ui.ts",
    "e2e": "playwright test",
    "test:unit": "bun test --path-ignore-patterns='**/*.test.tsx' ./scripts ./plugin/scripts ./bridges ./web",
    "test:dom": "bun test --preload ./web/happydom.ts --path-ignore-patterns='**/*.test.ts' ./web"
  },
  "type": "module"
}
