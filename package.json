{
  "name": "@minjun0219/rocky",
  "version": "0.22.2",
  "description": "rocky (named after Project Hail Mary) — the owner's personal agent tool. A Rust daemon (shared todo board + MCP) and CLI under crates/, with this package as the thin Claude Code plugin: worklog_* tools (append-only local JSONL agent journal, moving into the daemon next), Stop-hook turn capture, /rocky:recall, and the /rocky:next / brainstorm / review / finish / resolve-reviews workflow commands. Absorbed rocky-todo (D-046).",
  "license": "MIT",
  "author": "Minjun Kim",
  "homepage": "https://github.com/minjun0219/rocky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minjun0219/rocky.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "commands",
    ".claude-plugin",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "claude-code",
    "mcp",
    "todo",
    "board",
    "daemon",
    "worklog",
    "rocky",
    "rust",
    "bun"
  ],
  "scripts": {
    "check": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "test": "bun test ./src ./scripts",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "changeset": "bunx changeset",
    "changeset:version": "bunx changeset version && bun scripts/sync-plugin-version.ts",
    "prepare": "husky",
    "check:changesets": "bun scripts/check-changesets.ts"
  },
  "lint-staged": {
    "*.{ts,json,jsonc,md}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@minjun0219/biome-config": "2.1.0",
    "@types/bun": "^1.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "typescript": "^5.4.5"
  }
}
