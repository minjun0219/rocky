// 클라우드 중계소 Worker. 배포와 실측은 docs/features/sync.md 의 "배포와 실측".
// 개인 값(Access 팀·AUD·허용 이메일·데몬 Client ID)은 이 파일이 아니라 Worker secret 에 둔다 — 공개 레포다.
// 주소도 적지 않는다. Access 앱 뒤의 Custom Domain으로 한 번 단다(대시보드나 wrangler deploy --domain). 이 파일에
// routes가 없으면 뒤의 배포는 그 주소를 건드리지 않는다.
{
  "name": "rocky-relay",
  "main": "worker.ts",
  // 2026-04-07 이후라야 런타임이 닫힘 답을 대신한다(web_socket_auto_reply_to_close).
  "compatibility_date": "2026-10-01",
  // workers.dev·미리보기 주소는 Access 를 거치지 않는다. Worker 가 토큰을 다시 보지만 문을 하나 더 열 까닭이 없다.
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayObject" }]
  },
  "exports": {
    "RelayObject": { "type": "durable-object", "storage": "sqlite" }
  }
}
